generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Stadium {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  location    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  fleet       Fleet[]
  users       User[]
  departments Department[]
}

model Department {
  id        String   @id @default(cuid())
  name      String
  code      String?
  stadiumId String
  stadium   Stadium  @relation(fields: [stadiumId], references: [id])
  users     User[]
  fleet     Fleet[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, stadiumId])
  @@index([stadiumId])
}

// Cart types: Cargo, Accessibility, 6-Seater, 4-Seater
// Cart statuses: Available, Assigned, Dispatched, Under Maintenance
model Fleet {
  id              String           @id @default(cuid())
  carNumber       String           @unique
  carType         String           // Cargo, Accessibility, 6-Seater, 4-Seater
  status          String           @default("Available") // Available, Assigned, Dispatched, Under Maintenance
  requiresVAP     Boolean          @default(false)
  stadiumId       String
  stadium         Stadium          @relation(fields: [stadiumId], references: [id])
  departmentId    String?
  department      Department?      @relation(fields: [departmentId], references: [id])
  assignedUserId  String?          // FA user assigned to this cart
  assignedUser    User?            @relation("FleetAssignedUser", fields: [assignedUserId], references: [id])
  handoverLogs    HandoverLog[]
  maintenanceLogs MaintenanceLog[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([stadiumId])
  @@index([status])
  @@index([assignedUserId])
  @@index([departmentId])
}

// Roles: SuperAdmin, Admin, FA, Observer
model User {
  id              String          @id @default(cuid())
  name            String
  email           String          @unique
  passwordHash    String
  role            String          // SuperAdmin, Admin, FA, Observer
  phone           String?
  isActive        Boolean         @default(true)
  resetPasswordToken   String?    @unique
  resetPasswordExpires DateTime?
  exportFormat    String          @default("xlsx") // xlsx, pdf, docx
  stadiumId       String?
  stadium         Stadium?        @relation(fields: [stadiumId], references: [id])
  departmentId    String?
  department      Department?     @relation(fields: [departmentId], references: [id])
  handoverLogs    HandoverLog[]
  refreshTokens   RefreshToken[]
  assignedCarts   Fleet[]         @relation("FleetAssignedUser")
  maintenanceLogs MaintenanceLog[] @relation("MaintenanceReporter")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([stadiumId])
  @@index([role])
  @@index([departmentId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Actions: CheckedIn, CheckedOut, IssueReported
model HandoverLog {
  id             String   @id @default(cuid())
  fleetId        String
  fleet          Fleet    @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  action         String   // CheckedIn, CheckedOut, IssueReported
  timestamp      DateTime @default(now())
  conditionNotes String?
  photosUrls     String[] // Array of MinIO URLs (for issue reports)
  createdAt      DateTime @default(now())

  @@index([fleetId])
  @@index([userId])
  @@index([timestamp])
}

// Statuses: Open, InProgress, Resolved
model MaintenanceLog {
  id               String    @id @default(cuid())
  fleetId          String
  fleet            Fleet     @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  reportedById     String
  reportedBy       User      @relation("MaintenanceReporter", fields: [reportedById], references: [id])
  issueDescription String
  photosUrls       String[]  @default([]) // Photos uploaded with issue report
  reportedAt       DateTime  @default(now())
  status           String    @default("Open") // Open, InProgress, Resolved
  resolutionNotes  String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([fleetId])
  @@index([status])
  @@index([reportedById])
}

model SystemSettings {
  id             String   @id @default(cuid())
  tournamentName String   @default("Golf Cart Management System")
  logoUrl        String?
  headerUrl      String?
  footerUrl      String?
  footerText     String?
  updatedAt      DateTime @updatedAt
  updatedById    String?
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String   // Fleet, User, Handover, etc.
  entityId   String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())

  @@index([userId])
  @@index([entityType])
  @@index([timestamp])
}
