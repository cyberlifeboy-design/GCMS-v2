# Database
DATABASE_URL="postgresql://gcms_user:your_secure_password@localhost:5432/gcms"

# JWT - MUST be changed in production!
# Generate strong secrets: openssl rand -base64 64
JWT_ACCESS_SECRET="your-256-bit-access-secret-change-in-production"
JWT_REFRESH_SECRET="your-256-bit-refresh-secret-change-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# MinIO / S3
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY="your-minio-access-key"
MINIO_SECRET_KEY="your-minio-secret-key"
MINIO_BUCKET_NAME="gcms-uploads"

# Server
PORT=3005
NODE_ENV=development

# CORS
CORS_ORIGIN="http://localhost:3000"

# Email Configuration
# Production: Set RESEND_API_KEY and EMAIL_FROM
# Development: Uses MailHog (localhost:1025) - no configuration needed
RESEND_API_KEY="re_your_resend_api_key_here"
EMAIL_FROM="noreply@yourdomain.com"

# SMTP Configuration (for development with MailHog)
SMTP_HOST="localhost"
SMTP_PORT=1025
